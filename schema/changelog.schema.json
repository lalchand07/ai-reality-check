{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monthly changelog",
  "type": "object",
  "required": ["month", "entries"],
  "additionalProperties": false,
  "properties": {
    "month": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "tool", "type", "title", "summary", "impact", "sources"],
        "additionalProperties": false,
        "properties": {
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"},
          "tool": {"type": "string"},
          "type": {"enum": ["model", "pricing", "feature", "performance", "safety", "policy", "deprecation", "other"]},
          "title": {"type": "string", "maxLength": 120},
          "summary": {"type": "string"},
          "impact": {"enum": ["high", "medium", "low", "low-for-users"]},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}}
        }
      }
    }
  }
}
